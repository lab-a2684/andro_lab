# CVE-2024-23380 lab configuration
#
# Base: arch/arm64/configs/defconfig from msm-5.10 (vulnerable 36f524a278d3)
# Target: arm64 under stock qemu-system-aarch64 -M virt

# --- build hygiene ------------------------------------------------------------
# msm-5.10 (Android 12) was pinned to a hermetic Clang r416183b.  We build with
# the distro GCC 13, which is newer and flags a number of pre-existing issues
# in Qualcomm drivers (format-extra-args in kgsl_pwrctrl.c, an unused static in
# kgsl_sharedmem.c, a pointer printed with %x in bam_dma.c, an unused variable
# in drivers/clk/qcom/common.c).  Turning CONFIG_WERROR off keeps those as
# warnings so the tree builds unmodified; no source is changed to accommodate
# the compiler.
# CONFIG_WERROR is not set

# --- core requirements -------------------------------------------------------
CONFIG_OF=y
CONFIG_OF_EARLY=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_ADDRESS=y
CONFIG_OF_IRQ=y
CONFIG_OF_DYNAMIC=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_KCONFIG=y
CONFIG_OF_GPIO=y
CONFIG_OF_IOMMU=y
CONFIG_OF_MMIO=y
CONFIG_OF_RESOLVE=y
CONFIG_OF_SYM_ADDRESSES=y

CONFIG_ARM64=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_16K_PAGES=n
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_LSE_ATOMICS_BROKEN=n
CONFIG_SMP=y
CONFIG_HZ_1000=y
CONFIG_CMDLINE=""
CONFIG_RANDOMIZE_BASE=n
CONFIG_KASLR=n

# --- initramfs / early userspace --------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEFAULT_INITRAMFS_COMPRESS_GZIP=y
CONFIG_RD_GZIP=y

# --- SMMU --------------------------------------------------------------------
# KGSL's Qualcomm path uses the arm-smmu v2 driver (arm-smmu-qcom.c), selected
# by "qcom,qsmmu-v500" plus "qcom,adreno-smmu".  Both compatibles are required
# to satisfy the two independent VBO feature gates -- see kgsl_iommu.c:2500
# and :2602.  CONFIG_ARM_SMMU_V3 is intentionally not enabled: it selects a
# different driver with no qcom_adreno_smmu implementation.
CONFIG_ARM_SMMU=y
# CONFIG_ARM_SMMU_V3 is not set
CONFIG_ARM_SMMU_DISABLE_BYPASS_BY_DEFAULT=y
# CONFIG_ARM_SMMU_SELFTEST is not set

# --- Qualcomm platform prerequisites ----------------------------------------
# CONFIG_QCOM_KGSL depends on ARCH_QCOM && QCOM_QFPROM
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_QFPROM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMD_RPM=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_RMTFS=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_PDR=y
CONFIG_QCOM_Q6V5_MSM=y
CONFIG_REGMAP_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMH_PROVIDER=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_SMD_RPM=y

# --- KGSL --------------------------------------------------------------------
CONFIG_QCOM_KGSL=y
CONFIG_QCOM_KGSL_FENCE_TRACE=y
CONFIG_QCOM_KGSL_CORESIGHT=n
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=n
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=n
CONFIG_QCOM_KGSL_DEFAULT_PWRLEVEL=0
# CONFIG_QCOM_KGSL_DEFAULT_PWRLEVEL is an int
CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR="msm-adreno-tz"

# KGSL's downstream Qualcomm helpers are built into the same image. The
# generic defconfig leaves them as modules or omits them, which produces
# unresolved symbols when KGSL and arm-smmu are built in.
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_IOMMU_UTIL=y

# SYNC_FILE (required by KGSL fences) selects DMA_SHARED_BUFFER, so that
# parent symbol intentionally remains enabled.  The unsupported Qualcomm
# mem-buf import helpers are stubbed by the lab's additive testgpu source.

# --- clocks / regulators / power --------------------------------------------
CONFIG_COMMON_CLK=y
CONFIG_COMMON_CLK_DUMMY=n
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_PM=y
CONFIG_PM_GENERIC=y
CONFIG_PM_GENERIC_DUMMY=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DT=y
CONFIG_CPU_IDLE=y
CONFIG_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE=y

# --- drivers KGSL's DT/bind path will reference -----------------------------
CONFIG_RESET_CONTROLLER=y
CONFIG_PINCTRL_QCOM=y
CONFIG_PINCTRL_MSM=y
CONFIG_MFD_SYSCON=y
CONFIG_NVMEM=y
CONFIG_NVMEM_QCOM=y
CONFIG_QCOM_QFprom=y
CONFIG_MAILBOX=y
CONFIG_MAILBOX_PLATFORM=y
CONFIG_QCOM_IPCC_MAILBOX=y
CONFIG_INTERCONNECT=y
CONFIG_QCOM_SMEM_MAX_TABLE_SIZE=0

# --- filesystem / net (minimal harness) --------------------------------------
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX=y

# --- debug: keep it light so the build fits the box --------------------------
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_DEBUG_INFO_NONE=n
CONFIG_DEBUG_FS=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_SLAB_FREELIST_HARDENED=n
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_STACKTRACE=y
CONFIG_FRAME_POINTER=y
CONFIG_DETECT_HUNG_TASK=y
# CONFIG_DEBUG_ATOMIC_SLEEP is not set

# Exclude heavyweight subsystems we do not need
# CONFIG_XFS_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_DRM is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INFINIBAND is not set
# CONFIG_STAGING is not set
# CONFIG_NET_VENDOR_INTEL is not set
# CONFIG_ETHERNET is not set
# CONFIG_SCSI is not set
# CONFIG_ATA is not set

# --- unrelated pinned-tree driver mismatches --------------------------------
# These leaf drivers are not used by the KGSL reproduction and have API/
# configuration mismatches in this Qualcomm snapshot. Keep their parent
# subsystems enabled so no KGSL/IOMMU dependency is changed.
# CONFIG_QRTR_TUN is not set
# CONFIG_MMC_SDHCI_MSM is not set

# These unrelated parents also pull in virtualization/TEE subsystems that
# the KGSL guest does not use.
# CONFIG_XEN is not set
# CONFIG_TEE is not set
